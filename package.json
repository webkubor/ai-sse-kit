{
  "name": "ai-sse-kit",
  "version": "0.3.0",
  "description": "给「后端在自己手里」的项目做 AI 流式接收：SSE 分帧、协议适配（OpenAI/Anthropic/自定义）、消息不可变 patch、取消生命周期。不做 provider 抽象、不做 agent、不绑部署平台。/ AI streaming primitives for apps that own their own backend: SSE framing, protocol adapters, immutable message patching, cancellation lifecycle. No provider abstraction, no agent layer, no platform lock-in.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "author": "webkubor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/ai-sse-kit.git"
  },
  "keywords": [
    "ai",
    "sse",
    "server-sent-events",
    "streaming",
    "eventsource",
    "openai",
    "anthropic",
    "deepseek",
    "abortcontroller",
    "react",
    "vue"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "postpublish": "command -v cs >/dev/null 2>&1 && cs notify \"📦 ai-sse-kit v$npm_package_version 已发布 → https://www.npmjs.com/package/ai-sse-kit\" --project ai-sse-kit --level deployed || echo '（cs 不在这台机器上，跳过飞书通知，不影响发布结果）'"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  }
}
