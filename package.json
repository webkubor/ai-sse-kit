{
  "name": "ai-sse-kit",
  "version": "0.0.1",
  "description": "Progressive toolkit for AI streaming: SSE transport, protocol adapters (OpenAI/Anthropic/custom), and stream-safe message patching. Framework-agnostic core with React and Vue bindings. Start with useAIChat(), drop to primitives when you need custom protocols.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "author": "webkubor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/ai-sse-kit.git"
  },
  "keywords": [
    "ai",
    "sse",
    "streaming",
    "chat",
    "openai",
    "anthropic",
    "react",
    "vue"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react.js",
    "./vue": "./dist/vue.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  }
}
